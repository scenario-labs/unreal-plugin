        { "id": "model_hdri-skybox", "name": "HDRi Skybox", "mode": "hdri", "note": "HDR lighting from a panorama" }
      ]
    },
    {
      "id": "render",
      "title": "Render",
      "capability": "img2img",
      "importer": "texture",
      "folder": "Renders",
      "needs_capture": true,
      "hint": "Restyle the active viewport or a camera: captures the view and sends it as reference image 1.",
      "starter_prompts": [
        "painterly concept art, warm sunset light",
        "photoreal, wet street at night, neon reflections",
        "clean architectural visualization, soft daylight"
      ],
      "models": [
        { "id": "model_openai-gpt-image-2-5-flare", "name": "GPT Image 2.5 Flare", "note": "fast" },
        { "id": "model_google-gemini-3-1-flash", "name": "Gemini 3.1", "note": "keeps layout" },
        { "id": "model_bytedance-seedream-5-0-pro", "name": "Seedream 5.0 Pro", "note": "strong restyle" }
      ]
    }
  ],
  "tools": {
    "translate": "model_scenario-llm"
  },
  "presets": {
    "model_rodin-hyper3d-v2-5-text-to-3d": { "material": "PBR" },
    "model_hunyuan-3d-pro-3-1-i23d": { "enablePbr": true },
    "model_sonilo-v1-1-text-to-sound-effects": { "audioFormat": "wav", "duration": 2 },
    "model_scenario-skybox-flux": { "numOutputs": 1 }
  },
  "restrict": {
    "audioFormat": ["wav", "mp3", "ogg", "flac"]
  },
  "unreal_ready_prompt": "Unreal Engine 5 ready: real-world scale in centimeters, Z up, +X forward, pivot at the base center, UE5 Mannequin bone names for humanoid rigs, ARKit 52 blendshape names for faces, separate meshes for parts that move."
}
