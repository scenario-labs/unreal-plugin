{
  "version": 1,
  "updated": "2026-10-18",
  "note": "Lane defaults: Scenario recommend (quality priority) plus the newest models. Checked by tools/contract_check.py (free dry runs).",
  "lanes": [
    {
      "id": "image",
      "title": "Image",
      "capability": "txt2img",
      "importer": "texture",
      "folder": "Images",
      "hint": "Textures, concept art, UI pieces and decals. Lands on the selected actor's material or as a plane in front of the camera.",
