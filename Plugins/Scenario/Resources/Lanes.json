        { "id": "model_tripo-p2-text-to-3d", "name": "Tripo P2", "mode": "text", "note": "fast, stable topology" },
        { "id": "model_hunyuan-3d-pro-3-1-i23d", "name": "Hunyuan 3D 3.1 Pro", "mode": "image", "note": "from one image" },
        { "id": "model_tripo-v3-1-image-to-3d", "name": "Tripo 3.1", "mode": "image", "note": "clean game topology" },
        { "id": "model_meshy-7-1-img23d", "name": "Meshy 7.1", "mode": "image", "note": "remesh to a polycount" },
