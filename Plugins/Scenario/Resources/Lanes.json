        { "id": "model_sonilo-v1-1-text-to-music", "name": "Sonilo V1.1 Music", "note": "fast music beds" }
      ]
    },
    {
      "id": "video",
      "title": "Video",
      "capability": "txt2video",
      "importer": "media",
      "folder": "Video",
      "hint": "Clips as MP4 with a File Media Source, shown on a Media Plate in front of the camera.",
      "starter_prompts": [
        "lantern flame flickering in the wind, close-up, night",
        "slow drifting clouds over mountains, timelapse",
        "waterfall mist with sunlight, gentle camera push"
