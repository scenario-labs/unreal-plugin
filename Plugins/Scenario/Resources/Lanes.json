        { "id": "model_scenario-claude-opus-5-5-3d", "name": "Claude Opus 5.5 3D", "mode": "edit", "note": "edit, rig, animate", "unreal_ready": true },
        { "id": "model_scenario-gpt6-astra-3d", "name": "GPT-6 Astra 3D", "mode": "edit", "note": "edit, rig, animate", "unreal_ready": true },
        { "id": "model_meshy-rigging", "name": "Meshy Rigging", "mode": "edit", "note": "humanoid rig" },
