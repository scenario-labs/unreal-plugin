      "models": [
        { "id": "model_pruna-p-video-2-pro", "name": "P-Video 2 Pro", "note": "fast, low cost" },
        { "id": "model_google-omni-1-1-flash", "name": "Gemini Omni 1.1 Flash", "note": "Scenario's video pick" },
        { "id": "model_bytedance-seedance-2-5", "name": "Seedance 2.5", "note": "best motion, higher cost" }
      ]
    },
    {
      "id": "environment",
      "title": "Environment",
      "capability": "txt2img",
      "importer": "sky",
      "folder": "Environments",
      "recommend": false,
      "modes": ["generate", "hdri"],
      "hint": "360 skies on a sky sphere, or HDR lighting on an HDRI Backdrop.",
      "starter_prompts": [
        "golden hour over rolling hills, scattered clouds",
        "alien desert at dusk with two moons",
        "overcast harbor morning, soft light"
      ],
      "models": [
        { "id": "model_scenario-skybox-gpt", "name": "Scenario Skybox GPT", "mode": "generate", "note": "best quality" },
