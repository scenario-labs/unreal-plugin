    },
    {
      "id": "material",
      "title": "Material",
      "capability": "txt2img",
      "importer": "material",
      "folder": "Materials",
      "recommend": false,
      "hint": "Tileable PBR material set on the selected actor's material slot.",
      "starter_prompts": [
        "wet cobblestone street, dark mortar",
        "brushed steel with light scratches",
        "mossy forest floor with pebbles"
      ],
      "models": [
        { "id": "model_patina-material", "name": "PATINA Material", "note": "base color, normal, roughness, metallic, height" },
        { "id": "model_scenario-texture", "name": "Scenario Texture", "note": "one tileable color map" }
      ]
    },
    {
      "id": "audio",
      "title": "Audio",
      "capability": "txt2audio",
      "importer": "sound",
      "folder": "Audio",
      "hint": "Sound effects and music as Sound Waves, placed as an Ambient Sound.",
      "starter_prompts": [
        "heavy wooden door creaking open",
